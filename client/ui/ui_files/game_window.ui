         <!--
           Python tarafında SVG haritayı buraya yükle:

           from PyQt6.QtSvgWidgets import QSvgWidget
           self.svg_map = QSvgWidget("assets/world_map.svg", self.map_frame)
           self.svg_map.setGeometry(self.map_frame.rect())
           self.map_frame.resizeEvent = lambda e: self.svg_map.setGeometry(self.map_frame.rect())

           Ya da QGraphicsView + QGraphicsSvgItem kullanabilirsin
           tıklanabilir bölgeler için.
         -->
         <item>
